# Any ONE of these enables server-side AI generation. With none set, the app
# runs in demo mode (curated offline dataset) and users can bring their own
# key in Settings.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Cloud sync + accounts (optional). From Supabase Dashboard -> Project Settings
# -> Data API: Project URL and the anon/publishable key. Without these the app
# runs local-only (favorites stay in the browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Billing (optional until launch). All server-side only — never NEXT_PUBLIC.
# See README "Billing (Stripe)" for the setup walkthrough.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=
STRIPE_PRICE_LIFETIME=
STRIPE_PRICE_CREDITS=
# Supabase service-role key (Project Settings -> API keys). SERVER-SIDE SECRET:
# bypasses row-level security; required by the Stripe webhook to grant plans.
SUPABASE_SERVICE_ROLE_KEY=
