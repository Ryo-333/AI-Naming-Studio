# Any ONE of these enables server-side AI generation. With none set, the app
# runs in demo mode (curated offline dataset) and users can bring their own
# key in Settings.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Cloud sync + accounts (optional). From Supabase Dashboard -> Project Settings
# -> Data API: Project URL and the anon/publishable key. Without these the app
# runs local-only (favorites stay in the browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
